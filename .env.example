# ==============================================================================
# FASHION AFFILIATE STORE - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local for local development.
# Never commit .env or .env.local containing real secrets to version control.
# ==============================================================================

# Core Application Settings
NEXT_PUBLIC_SITE_NAME="LUMIÈRE Fashion Discovery"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_CURRENCY="INR"
NEXT_PUBLIC_CONTACT_EMAIL="concierge@lumiere-fashion.example"

# Security & Outbound Affiliate Settings
# Comma-separated list of approved external merchant domains for redirection
AFFILIATE_ALLOWED_DOMAINS="myntra.com,ajio.com,amazon.in,tatacliq.com,nykaafashion.com,marksandspencer.in,zara.com,hm.com"

# Optional Database Connection (Uncomment when moving from local JSON repository to PostgreSQL)
# DATABASE_URL="postgresql://user:password@localhost:5432/fashion_affiliate?schema=public"

# Optional Administrative Secret Key (Used to protect internal dev health/admin endpoints)
# Never expose secrets with NEXT_PUBLIC_
ADMIN_SECRET_KEY="dev_placeholder_secret_key_change_in_production"

# Optional Analytics Flag (Safe local default is disabled)
ENABLE_ANALYTICS=false
