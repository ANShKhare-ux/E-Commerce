# LUMIÈRE E-Commerce Environment Configuration (India)
# Copy to .env.local for local development. NEVER commit real secret credentials.

# -----------------------------------------------------------------------------
# APPLICATION BASE URL
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# SUPABASE POSTGRESQL & AUTHENTICATION
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
# Server-only service role key (Required for backend automation, webhooks, and secure admin operations)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# -----------------------------------------------------------------------------
# INITIAL STORE OWNER / ADMINISTRATOR
# The email address below is authorized as the primary Super Administrator
# -----------------------------------------------------------------------------
ADMIN_EMAIL=owner@lumiere.in

# -----------------------------------------------------------------------------
# CRON & AUTOMATION AUTHENTICATION
# Authorization token expected in Authorization header: Bearer <CRON_SECRET>
# -----------------------------------------------------------------------------
CRON_SECRET=lumiere_cron_secure_secret_token_123456

# -----------------------------------------------------------------------------
# INDIAN PAYMENT GATEWAY (Razorpay UPI / Cards / Netbanking)
# When keys are left blank, sandbox demo simulation mode is safely engaged
# -----------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_signature

# -----------------------------------------------------------------------------
# DELHIVERY LOGISTICS INTEGRATION (India Shipping & Tracking)
# Official Delhivery API credentials for shipment booking and waybill generation
# -----------------------------------------------------------------------------
DELHIVERY_API_TOKEN=your_delhivery_api_token_here
DELHIVERY_CLIENT_NAME=LUMIERE_RETAIL
DELHIVERY_WAREHOUSE_NAME=LUMIERE_MUMBAI_HUB
DELHIVERY_IS_PRODUCTION=false

# -----------------------------------------------------------------------------
# TRANSACTIONAL EMAIL (Resend / Custom SMTP)
# If unconfigured, transactional emails are recorded in database outbox and logged
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_placeholder_secret_key
EMAIL_FROM="LUMIÈRE <concierge@lumiere.in>"

# -----------------------------------------------------------------------------
# AFFILIATE & ANALYTICS
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ANALYTICS_ID=
AFFILIATE_PARTNER_SECRET=
